APP_ENV=local
APP_NAME=auth-core
AUTH_API_PORT=8000
WEB_PORT=3000
JWT_VERIFIER_PORT=8081
POSTGRES_PORT=5432
POSTGRES_DB=auth_core
POSTGRES_USER=auth_core
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://auth_core:local-development-only@postgres:5432/auth_core
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_KEY_HMAC_SECRET=local-development-key-change-me
OTP_HMAC_SECRET=local-otp-key-change-me
LOGIN_SIGNAL_HMAC_SECRET=local-login-signal-key-change-me
LOCAL_OIDC_SIGNING_SECRET=local-oidc-signing-key-change-me
LOCAL_OIDC_FRONTEND_URL=http://localhost:3000
LOCAL_CAPTCHA_TOKEN=local-development-pass
VERIFICATION_BASE_URL=http://localhost:3000/verify-email
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_SENDER=no-reply@local.vittavaan.test
LOCAL_SMS_INBOX=sms@local.vittavaan.test
HIBP_USER_AGENT=Vittavaan-auth-core/0.1 security@vittavaan.test
REGISTRATION_PROVIDER_MODE=local
LOGIN_PROVIDER_MODE=local
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
